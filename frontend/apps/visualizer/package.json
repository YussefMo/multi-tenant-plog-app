{
  "name": "@multi-tenant-plog/visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3003 --strictPort",
    "predev": "pnpm generate:requests",
    "build": "pnpm generate:requests && tsgo --noEmit && vite build",
    "preview": "vite preview --port 3003 --strictPort",
    "pretypecheck": "pnpm generate:requests",
    "typecheck": "tsgo --noEmit",
    "generate:requests": "node scripts/generate-requests.mjs",
    "prevalidate": "pnpm generate:requests",
    "validate": "node scripts/validate-atlas.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
