APP_NAME="Multi Tenant Plog App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://multi-tenant-plog.test
PUBLIC_API_URL=http://multi-tenant-plog.test
DOCS_USERNAME=docs
DOCS_PASSWORD=

OWNER_FRONTEND_URL=http://localhost:3000
TENANT_FRONTEND_URL=http://localhost:3001
USER_FRONTEND_URL=http://localhost:3002
TENANT_SUPPORT_PATH=/support/accept
TENANT_ACCEPT_INVITATION_PATH=/accept-invitation
TENANT_BILLING_PATH=/billing
SUPPORT_TICKET_TTL_MINUTES=5
SUPPORT_SESSION_IDLE_MINUTES=5
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
CORS_ALLOWED_ORIGIN_PATTERNS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multi_tenant_plog_app
DB_USERNAME=root
DB_PASSWORD=

OWNER_DB_CONNECTION=mysql
OWNER_DB_HOST=127.0.0.1
OWNER_DB_PORT=3306
OWNER_DB_DATABASE=multi_tenant_plog_owner
OWNER_DB_USERNAME=root
OWNER_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=tenant_session
OWNER_SESSION_COOKIE=owner_session
OWNER_SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_MODE=sandbox
STRIPE_ALLOW_LIVE=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-09-30.endive

STRIPE_PLAN_1_PRODUCT_ID=
STRIPE_PLAN_1_PRICE_ID=
STRIPE_PLAN_2_PRODUCT_ID=
STRIPE_PLAN_2_PRICE_ID=
