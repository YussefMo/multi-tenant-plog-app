{
  "name": "multi-tenant-plog-app",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "install:frontend": "pnpm --dir frontend install",
    "format": "pnpm --dir frontend format",
    "format:check": "pnpm --dir frontend format:check",
    "format:repo": "pnpm --dir frontend format:repo",
    "format:check:repo": "pnpm --dir frontend format:check:repo",
    "dev": "pnpm --dir frontend dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:owner": "pnpm --dir frontend dev:owner",
    "dev:tenant": "pnpm --dir frontend dev:tenant",
    "dev:user": "pnpm --dir frontend dev:user",
    "dev:visualizer": "pnpm --dir frontend dev:visualizer",
    "build": "pnpm --dir frontend build",
    "build:visualizer": "pnpm --dir frontend build:visualizer",
    "build:frontend": "pnpm --dir frontend build:frontend",
    "typecheck": "pnpm --dir frontend typecheck",
    "typecheck:frontend": "pnpm --dir frontend typecheck:frontend",
    "test": "pnpm --dir frontend test",
    "test:frontend": "pnpm --dir frontend test",
    "test:watch": "pnpm --dir frontend test:watch",
    "test:coverage": "pnpm --dir frontend test:coverage",
    "generate:requests": "pnpm --dir frontend generate:requests",
    "atlas:validate": "pnpm --dir frontend atlas:validate"
  }
}
